module(
    name = "canvas_wasm_cc_engine",
    version = "0.1.0",
)

bazel_dep(name = "rules_cc", version = "0.2.16")
bazel_dep(name = "aspect_rules_js", version = "3.0.3")
bazel_dep(name = "emsdk", version = "4.0.17")

bazel_dep(name = "platforms", version = "1.0.0")

bazel_dep(name = "skia", version = "0.0.0")
git_override(
    module_name = "skia",
    remote = "https://github.com/google/skia.git",
    commit = "c5c3399b3a8483f04f6d302630de2402e59b5b46",
    patches = ["//:third_party/skia_graphite_dawn.patch"],
    patch_strip = 1,
)

bazel_dep(name = "skia_user_config", version = "1.0")
local_path_override(
    module_name = "skia_user_config",
    path = "third_party/custom_skia_config",
)

skia_deps = use_extension("@skia//bazel:cpp_modules.bzl", "cpp_modules")
skia_deps.from_file(deps_json = "@skia//bazel:deps.json")

# Explicitly bring the repositories generated by the Skia module extension into
# the scope of the current module.
use_repo(
    skia_deps,
    "libpng",
    "zlib",
    "dawn",
)
