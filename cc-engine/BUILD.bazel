load("@aspect_rules_js//js:defs.bzl", "js_binary")
load("@emsdk//emscripten_toolchain:wasm_rules.bzl", "wasm_cc_binary")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")

package(default_visibility = ["//visibility:public"])

config_setting(
    name = "wasm_build",
    constraint_values = [
        "@platforms//cpu:wasm32",
        "@platforms//os:emscripten",
    ],
)

cc_library(
    name = "fiddle_base",
    srcs = ["fiddle_base.cc"],
    hdrs = ["fiddle_base.h"],
    target_compatible_with = select({
        ":wasm_build": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

cc_library(
    name = "fiddle_registry",
    srcs = ["fiddle_registry.cc"],
    hdrs = ["fiddle_registry.h"],
    target_compatible_with = select({
        ":wasm_build": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [":fiddle_base"],
)

cc_library(
    name = "fiddle_manager",
    srcs = ["fiddle_manager.cc"],
    hdrs = ["fiddle_manager.h"],
    target_compatible_with = select({
        ":wasm_build": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":fiddle_base",
        ":fiddle_registry",
        "//fiddles:elastic_text_fiddle",
        "//fiddles:ribbon_field_fiddle",
        "//fiddles:shape_intersection_fiddle",
        "//fiddles:skia_cpu_fiddle",
        "//fiddles:skia_webgl_fiddle",
        "//fiddles:sksl_image_proc_fiddle",
    ],
)

# This target intentionally has no main function. Emscripten turns it into the
# JavaScript-loadable module below, and --no-entry allows that link mode.
cc_binary(
    name = "demo",
    srcs = ["bindings.cc"],
    linkopts = [
        "-s MODULARIZE=1",
        "-s EXPORT_ES6=1",
        "-s USE_ES6_IMPORT_META=1",
        "-s ENVIRONMENT=web,worker",
        "-s MAX_WEBGL_VERSION=2",
        "-s USE_WEBGL2=1",
        "-s ALLOW_MEMORY_GROWTH=1",
        "-s EXPORT_NAME=CreateCanvasDemoModule",
        "-s ASSERTIONS=1",
        "--bind",
        "--closure=0",
        "--no-entry",
    ],
    tags = ["manual"],
    deps = [
        ":fiddle_manager",
        "//images:skia_image_store",
        "//text:skia_font_manager",
    ],
)

wasm_cc_binary(
    name = "demo_wasm",
    cc_target = ":demo",
)

js_binary(
    name = "wasm_exporter",
    data = [
        "wasm_exporter.mjs",
        ":demo_wasm",
    ],
    entry_point = "wasm_exporter.mjs",
)
