load("@aspect_rules_js//js:defs.bzl", "js_binary")
load("@emsdk//emscripten_toolchain:wasm_rules.bzl", "wasm_cc_binary")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")

package(default_visibility = ["//visibility:public"])

config_setting(
    name = "wasm_build",
    constraint_values = [
        "@platforms//cpu:wasm32",
        "@platforms//os:emscripten",
    ],
)

cc_library(
    name = "wasm_canvas",
    srcs = ["wasm_canvas.cc"],
    hdrs = ["wasm_canvas.h"],
    target_compatible_with = select({
        ":wasm_build": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//core:fiddle_base",
        "//core:fiddle_manager",
    ],
)

# This target intentionally has no main function. Emscripten turns it into the
# JavaScript-loadable module below, and --no-entry allows that link mode.
cc_binary(
    name = "demo",
    srcs = ["bindings.cc"],
    linkopts = [
        "-s MODULARIZE=1",
        "-s EXPORT_ES6=1",
        "-s USE_ES6_IMPORT_META=1",
        "-s ENVIRONMENT=web,worker",
        "-s MAX_WEBGL_VERSION=2",
        "-s USE_WEBGL2=1",
        "-s ALLOW_MEMORY_GROWTH=1",
        "-s EXPORT_NAME=CreateCanvasDemoModule",
        "-s ASSERTIONS=1",
        "--bind",
        "--closure=0",
        "--no-entry",
    ],
    tags = ["manual"],
    deps = [
        ":wasm_canvas",
        "//images:skia_image_store",
        "//text:skia_font_manager",
    ],
)

wasm_cc_binary(
    name = "demo_wasm",
    cc_target = ":demo",
)

js_binary(
    name = "wasm_exporter",
    data = [
        "wasm_exporter.mjs",
        ":demo_wasm",
    ],
    entry_point = "wasm_exporter.mjs",
)
